{
  "name": "OfficeRapide - Suite Bureautique Complète",
  "short_name": "OfficeRapide",
  "description": "Suite bureautique complète avec Word, Excel, PowerPoint et Outlook",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f3f4f6",
  "theme_color": "#2b579a",
  "orientation": "any",
  "categories": ["productivity", "utilities", "business"],
  "lang": "fr-FR",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Word - Traitement de texte",
      "short_name": "Word",
      "description": "Ouvrir Word",
      "url": "/?app=word",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Excel - Tableur",
      "short_name": "Excel",
      "description": "Ouvrir Excel",
      "url": "/?app=sheet",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "PowerPoint - Présentations",
      "short_name": "PowerPoint",
      "description": "Ouvrir PowerPoint",
      "url": "/?app=slide",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Outlook - Messagerie",
      "short_name": "Outlook",
      "description": "Ouvrir Outlook",
      "url": "/?app=mail",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/html": [".html", ".htm"],
        "text/plain": [".txt", ".md"],
        "text/csv": [".csv"]
      }
    }
  ]
}
