# Variables d'environnement pour OfficeRapide
# Copiez ce fichier vers .env et remplissez les valeurs

# API Keys (optionnel - pour fonctionnalités futures)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Cloud Storage (optionnel - pour synchronisation future)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id

# Analytics (optionnel)
VITE_ANALYTICS_ID=your_analytics_id

# Feature Flags
VITE_ENABLE_AI_ASSISTANT=false
VITE_ENABLE_CLOUD_SYNC=false
VITE_ENABLE_COLLABORATION=false

# App Configuration
VITE_APP_NAME=OfficeRapide
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
